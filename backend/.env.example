# Sentinel UEBA - Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials to version control.

# Database (PostgreSQL)
DATABASE_URL=postgresql://sentinel:CHANGE_ME@localhost:5432/sentinel_db

# JWT Authentication
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins in JSON format)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Environment
ENVIRONMENT=development
