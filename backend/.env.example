# ---------------------------------------------------------------------------
# SENTINEL backend configuration (spec §30)
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so it must
# never hold a real credential. The values below are development placeholders —
# every one of them is safe to read in a public repository precisely because
# none of them is a secret.
#
#   cp .env.example .env
#
# Generate a real signing key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------

# -- Database ---------------------------------------------------------------
# PostgreSQL in every real environment. `sqlite:///./sentinel.db` works for a
# quick local run, but the migrations and the UUID columns are exercised only
# against Postgres.
DATABASE_URL=postgresql://sentinel:CHANGE_ME@localhost:5432/sentinel_db

# -- Authentication ---------------------------------------------------------
# CHANGE THIS. Anyone holding this value can mint a token for any account.
JWT_SECRET=CHANGE_ME_generate_a_64_byte_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -- CORS -------------------------------------------------------------------
# JSON array. Must match the origin the frontend is served from.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# -- Environment ------------------------------------------------------------
# "production" suppresses stack traces in API error responses (spec §23).
ENVIRONMENT=development

# -- Machine learning -------------------------------------------------------
# Trained Isolation Forest artefact. Empty means the default:
# backend/models/isolation_forest.joblib
#
# Deleting this file disables ML scoring; detection then runs on the rule
# engine and baseline deviation alone, which the risk engine renormalises for.
MODEL_PATH=

# -- Optional ---------------------------------------------------------------
# Reserved for cross-process rate limiting. The in-process limiter is used when
# this is unreachable.
REDIS_URL=redis://localhost:6379

# Shared bootstrap key for the endpoint agent (X-Agent-Key). Prefer per-device
# keys issued through the admin API; this is only a first-contact credential.
AGENT_API_KEY=
